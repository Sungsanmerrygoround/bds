# 공공데이터포털 일반 인증키 (Decoding) — 실거래·청약홈·K-apt
DATA_GO_KR_SERVICE_KEY=

# 한국은행 ECOS 인증키 (금리, npm run ingest -- rates)
ECOS_API_KEY=

# 한국부동산원 R-ONE 인증키 (주간 지수, npm run ingest -- index)
REB_API_KEY=

# Supabase (서버·수집 스크립트 전용. NEXT_PUBLIC_ 접두사 금지)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# 마이그레이션 적용용 (Supabase > Project Settings > Database > Connection string > URI, Session pooler)
# 로컬 전용. Vercel/GitHub에는 넣지 않음
SUPABASE_DB_URL=
