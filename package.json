{
  "name": "bds",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "ingest": "tsx ingest/run.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:push": "node -e \"require('dotenv').config({path:'.env.local',quiet:true});require('child_process').execSync('npx supabase db push --db-url \"'+process.env.SUPABASE_DB_URL+'\"',{stdio:'inherit'})\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.6",
    "pretendard": "^1.3.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
